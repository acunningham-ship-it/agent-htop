<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.acunningham.agent-htop</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/agent-htop</string>
		<string>daemon</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>StandardOutPath</key>
	<string>$HOME/.config/agent-htop/daemon.log</string>

	<key>StandardErrorPath</key>
	<string>$HOME/.config/agent-htop/daemon.log</string>

	<key>WorkingDirectory</key>
	<string>$HOME</string>

	<key>Comment</key>
	<string>Monitor AI Agent Fleets (Claude Code, Codex, Paperclip)</string>
</dict>
</plist>
